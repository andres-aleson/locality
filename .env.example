# Copy to .env.local for local development, and set the same keys (except
# MIGRATION_DATABASE_URL) in the Vercel project's Environment Variables.

# Postgres as the `locality_app` role (Render external URL). Can only
# read/write rows in the `locality` schema.
DATABASE_URL="postgresql://locality_app:PASSWORD@HOST.oregon-postgres.render.com/DBNAME"

# Admin connection used only by `npm run db:migrate`. Never set on Vercel.
MIGRATION_DATABASE_URL=""

# Auth.js session signing secret. Generate with: npx auth secret  (or openssl rand -base64 33)
AUTH_SECRET=""

# Google OAuth client for sign-in. Authorized redirect URI:
#   https://<your-domain>/api/auth/callback/google  (and http://localhost:3000/... for dev)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Basic-auth passwords for the admin pages (user: admin). Unset = admin locked.
ADMIN_PASSWORD=""
LOCALITY_ADMIN_PASSWORD=""

# Optional: Claude for LocalReach plan/content generation (mock output if unset).
ANTHROPIC_API_KEY=""

# Optional: set to "true" to take /locality offline with a 503.
LOCALITY_MAINTENANCE_MODE=""

# Optional, currently unused (document upload is disabled): Google Drive storage
# for Locality license/residence photos. See src/lib/locality/googleDrive.ts.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_DRIVE_FOLDER_ID=""
