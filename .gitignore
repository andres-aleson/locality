# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# locality: local submission records (contains uploader PII)
/data/

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling / machine-specific (settings.local.json contains test admin passwords)
.claude/
src/app/.claude/

# tesseract language data (downloaded at runtime, 5MB binary)
eng.traineddata
!.env.example
